# ==============================================================================
# SANJIVANI COLLEGE OF ENGINEERING - RESULT MANAGEMENT SYSTEM (RMS)
# BACKEND ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# IMPORTANT: Copy this file to .env and replace placeholders with secure values.
# NEVER commit .env or secrets to source control.

# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String
# Local Development: mongodb://127.0.0.1:27017/sanjivani_rms
# Production Atlas:   mongodb+srv://<db_user>:<db_password>@cluster0.xxxxx.mongodb.net/sanjivani_rms?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/sanjivani_rms

# Client Application URL(s) for Cross-Origin Resource Sharing (CORS)
# Supports single URL, comma-separated list, or '*' for public API mode.
# Example: https://rms.sanjivani.edu.in,http://localhost:5173
CLIENT_URL=http://localhost:5173

# Authentication & Session Security
# Generate a cryptographically secure 256-bit secret in production using:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_strong_random_256_bit_secret_for_production
JWT_EXPIRES_IN=7d
COOKIE_NAME=rms_token

# Cookie SameSite Policy
# - 'lax' for same-domain or reverse proxy deployment (recommended default)
# - 'none' for cross-domain decoupled hosting (e.g. Vercel frontend + Render backend with HTTPS)
# - 'strict' for top-level strict isolation
COOKIE_SAMESITE=lax
