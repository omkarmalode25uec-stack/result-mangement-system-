{
  "name": "rms-backend",
  "version": "1.0.0",
  "description": "Backend API for Sanjivani College of Engineering Result Management System",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "node tests/runTests.js",
    "seed": "node -e \"import('./config/db.js').then(m => m.connectDB()).then(() => import('./utils/seedData.js')).then(s => s.seedDatabase()).then(() => process.exit(0))\""
  },
  "keywords": [
    "rms",
    "result-management-system",
    "sanjivani",
    "express",
    "mongoose"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.9.2"
  },
  "devDependencies": {
    "nodemon": "^3.1.9"
  }
}
